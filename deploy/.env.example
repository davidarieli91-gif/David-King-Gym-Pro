# Copy this file to deploy/.env and fill every value.
# Generate secrets with: openssl rand -hex 32

# --- storage locations -------------------------------------------------
# Bind-mount the database and file storage onto the NVMe volume on a NAS.
# Unset both to keep the default named Docker volumes instead.
DKG_PG_DIR=/volume2/dkg/data/pg
DKG_FILES_DIR=/volume2/dkg/data/files

# --- database -------------------------------------------------------------
POSTGRES_DB=dkg
POSTGRES_USER=dkg
POSTGRES_PASSWORD=change-me-strong-db-password

SESSION_SECRET=change-me-64-hex
INVITE_PEPPER=change-me-64-hex
COOKIE_SECURE=true
SESSION_DAYS=30

# Public URL. On Tailscale Funnel it looks like:
# https://dxp2800server.tailXXXXX.ts.net
PUBLIC_BASE_URL=https://change-me.tailXXXXX.ts.net

MAX_FILE_MB=25

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM=David King Gym <your@gmail.com>
