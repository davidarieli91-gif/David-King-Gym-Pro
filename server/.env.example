# Server
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:8080
SERVE_STATIC=false
STATIC_DIR=../dist

# Database
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/dkg

# Secrets (generate with: openssl rand -hex 32)
SESSION_SECRET=change-me-session-secret
INVITE_PEPPER=change-me-invite-pepper
COOKIE_SECURE=false
SESSION_DAYS=30

# Storage
STORAGE_DIR=./data/files
MAX_FILE_MB=25

# SMTP (Gmail app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=David King Gym <your@gmail.com>

# Bootstrap director (used once by npm run create-director)
DIRECTOR_EMAIL=
DIRECTOR_PASSWORD=
DIRECTOR_NAME=David
TENANT_NAME=David King Gym
